{
  "name": "sesshush",
  "version": "1.0.0",
  "description": "Sesshush \u2014 command output filter for AI coding agents. Compresses noisy CLI output, tracks token savings. Works with opencode, Codex, Claude Code, and more.",
  "type": "module",
  "bin": {
    "sesshush": "./bin/sesshush.js"
  },
  "files": [
    "bin",
    "src",
    "scripts/sync-engine.mjs",
    "install.sh",
    "install.ps1",
    "uninstall.sh",
    "uninstall.ps1",
    "vscode-extension/*.vsix",
    "TESTING.md",
    "README.md"
  ],
  "scripts": {
    "sync:engine": "node scripts/sync-engine.mjs",
    "build:vsix": "node scripts/sync-engine.mjs && cd vscode-extension && npx --yes @vscode/vsce package --allow-missing-repository",
    "test": "node --test \"test/*.test.mjs\" \"test/*.test.js\"",
    "test:all": "node --test \"test/*.test.mjs\" \"test/*.test.js\" \"test/server/*.test.js\" \"vscode-extension/test/*.test.mjs\"",
    "prepublishOnly": "node scripts/sync-engine.mjs --check && npm test"
  },
  "keywords": [
    "cli",
    "proxy",
    "tokens",
    "ai",
    "compression",
    "opencode",
    "codex",
    "claude",
    "token-savings",
    "sesshush"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HASSANFARYAD/token-killer.git"
  },
  "bugs": {
    "url": "https://github.com/HASSANFARYAD/token-killer/issues"
  },
  "homepage": "https://github.com/HASSANFARYAD/token-killer#readme",
  "engines": {
    "node": ">=18"
  }
}
