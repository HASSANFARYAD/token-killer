{
  "name": "sesshush-token-savings",
  "displayName": "Sesshush Token Savings",
  "description": "Shows Sesshush token savings for the current agent chat session in the VS Code status bar.",
  "version": "1.0.0",
  "publisher": "has-san",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:sesshush.refresh",
    "onCommand:sesshush.startAgentTerminal",
    "onCommand:sesshush.newSession"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sesshush.refresh",
        "title": "Sesshush: Refresh Token Savings"
      },
      {
        "command": "sesshush.newSession",
        "title": "Sesshush: Start New Session"
      },
      {
        "command": "sesshush.startAgentTerminal",
        "title": "Sesshush: Start Agent Terminal"
      }
    ],
    "configuration": {
      "title": "Sesshush Token Savings",
      "properties": {
        "sesshush.command": {
          "type": "string",
          "default": "sesshush",
          "description": "Command used to run Sesshush."
        },
        "sesshush.refreshIntervalMs": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "description": "How often the status bar refreshes token savings."
        },
        "sesshush.defaultAgentCommand": {
          "type": "string",
          "default": "codex",
          "description": "Default command for Sesshush: Start Agent Terminal."
        },
        "sesshush.showTotalWhenNoSession": {
          "type": "boolean",
          "default": true,
          "description": "Show lifetime total savings when the active session has no recorded runs."
        }
      }
    }
  }
}
