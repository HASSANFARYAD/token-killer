# Sesshush Server — Environment Variables
# Copy to .env and fill in values before running
#
# Fallback env vars are also supported for backward compatibility:
#   SESSHUSH_* (primary) → NOISEGATE_* → RTK_*

# --------------------------------------------------
# REQUIRED
# --------------------------------------------------

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSHUSH_JWT_SECRET=

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSHUSH_ENCRYPTION_KEY=

# Base URL of this server (used in invite links, OAuth callbacks)
SESSHUSH_BASE_URL=http://localhost:3000

# --------------------------------------------------
# MICROSOFT OAUTH (optional — skip for local auth only)
# --------------------------------------------------
SESSHUSH_MS_CLIENT_ID=
SESSHUSH_MS_CLIENT_SECRET=
SESSHUSH_MS_TENANT_ID=common
SESSHUSH_MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --------------------------------------------------
# OPTIONAL
# --------------------------------------------------
PORT=3000
SESSHUSH_LOG_LEVEL=info
SESSHUSH_DB_PATH=./data/sesshush.db

# Rate limiting
SESSHUSH_RATE_LIMIT_WINDOW_MS=900000
SESSHUSH_RATE_LIMIT_MAX=100
SESSHUSH_RATE_LIMIT_AUTH_MAX=10
