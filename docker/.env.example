# NoiseGate Server — Environment Variables
# Copy to .env and fill in values before running

# --------------------------------------------------
# REQUIRED
# --------------------------------------------------

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RTK_JWT_SECRET=

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RTK_ENCRYPTION_KEY=

# Base URL of this server (used in invite links, OAuth callbacks)
RTK_BASE_URL=http://localhost:3000

# --------------------------------------------------
# MICROSOFT OAUTH (optional — skip for local auth only)
# --------------------------------------------------
RTK_MS_CLIENT_ID=
RTK_MS_CLIENT_SECRET=
RTK_MS_TENANT_ID=common
RTK_MS_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# --------------------------------------------------
# OPTIONAL
# --------------------------------------------------
PORT=3000
RTK_LOG_LEVEL=info
RTK_DB_PATH=./data/rtk.db

# Rate limiting
RTK_RATE_LIMIT_WINDOW_MS=900000
RTK_RATE_LIMIT_MAX=100
RTK_RATE_LIMIT_AUTH_MAX=10
